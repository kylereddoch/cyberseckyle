    <div class="bg-[var(--surface)] rounded-lg p-6 border border-pink-200 dark:border-pink-800 md:col-span-2">
      <h2 class="text-lg font-semibold mb-4 text-pink-700 dark:text-pink-300 flex items-center gap-2">
        <span aria-hidden="true">&#128221;</span>
        <span>Recent Posts</span>
      </h2>

      {% set recent = collections.homeEntries | default([]) %}
      {% if recent | length > 0 %}
      <ul class="space-y-2">
        {% for post in recent | head(5) %}
        {% set entryType = post.data.contentType or 'post' %}
        {% if '/now/' in post.url %}
          {% set entryType = 'now' %}
        {% endif %}
        {% if entryType == 'note' %}
          {% set entryIcon = '&#128221;' %}
        {% elseif entryType == 'journal' %}
          {% set entryIcon = '&#128214;' %}
        {% elseif entryType == 'now' %}
          {% set entryIcon = '&#128205;' %}
        {% else %}
          {% set entryIcon = '&#9997;&#65039;' %}
        {% endif %}
        <li>
          <a href="{{ post.url }}" class="block hover:text-pink-600 dark:hover:text-pink-400">
            <span class="text-xs mr-2">{{ entryIcon | safe }}</span>
            <span class="font-medium">{{ post.data.title }}</span>
            {% if post.date %}
            <span class="text-sm text-gray-500 dark:text-gray-400 block">{{ post.date | readableDate }}</span>
            {% endif %}
          </a>
        </li>
        {% endfor %}
      </ul>
      {% else %}
      <p class="text-gray-500 dark:text-gray-400 italic">No posts yet. Start writing!</p>
      {% endif %}
    </div>

