---
layout: base
permalink: /projects/
title: Projects
description: "Open-source tools, themes, and experiments I have built or am actively working on."
projectGridColumns: 2
---
{# Change projectGridColumns above between 2 and 3 to switch the desktop grid density. #}
{% set gridColumns = 3 if projectGridColumns == 3 else 2 %}
{% set projectGridClass = 'md:grid-cols-2 lg:grid-cols-3' if gridColumns == 3 else 'md:grid-cols-2' %}

<div class="max-w-4xl">
  <h1 class="text-3xl font-bold mb-2 flex items-center gap-2">
    <span aria-hidden="true">&#128736;&#65039;</span>
    <span>Projects</span>
  </h1>
  <p class="text-gray-600 dark:text-gray-400 mb-8">
    These are the tools, themes, and experiments I am building in public. If Portfolio is the broader picture of my work, Projects is the hands-on repo list. Open any project for more context, screenshots, notes, and links.
  </p>

  {% if collections.projects and collections.projects.length %}
    <div class="grid grid-cols-1 gap-6 {{ projectGridClass }}">
      {% for project in collections.projects %}
        {% set cardSummary = project.data.summary or project.data.description %}
        {% set typeBadgeClasses = project.data.badgeClasses or 'bg-gray-100 text-gray-800 dark:bg-gray-800 dark:text-gray-200' %}
        {% set statusBadgeClasses = 'border border-slate-300 bg-slate-100 text-slate-800 dark:border-slate-600 dark:bg-slate-700 dark:text-slate-100' %}
        <article class="group flex h-full flex-col rounded-lg border border-gray-200 bg-[var(--surface)] p-6 shadow-sm transition-colors hover:border-blue-300 dark:border-gray-800 dark:hover:border-blue-700">
          <div class="flex flex-wrap items-center gap-3">
            <h2 class="text-xl font-semibold leading-tight">{{ project.data.title }}</h2>
            {% if project.data.projectType %}
              <span class="rounded-full px-3 py-1 text-xs font-medium {{ typeBadgeClasses }}">{{ project.data.projectType }}</span>
            {% endif %}
            {% if project.data.projectStatus %}
              <span class="rounded-full px-3 py-1 text-xs font-medium {{ statusBadgeClasses }}">{{ project.data.projectStatus }}</span>
            {% endif %}
          </div>

          {% if cardSummary %}
            <p class="mt-3 text-gray-700 dark:text-gray-300">
              {{ cardSummary }}
            </p>
          {% endif %}

          {% if project.data.techStack and project.data.techStack.length %}
            <ul class="mt-4 flex flex-wrap gap-2">
              {% for item in project.data.techStack %}
                <li class="rounded-full border border-gray-200 px-3 py-1 text-xs text-gray-600 dark:border-gray-700 dark:text-gray-300">{{ item }}</li>
              {% endfor %}
            </ul>
          {% endif %}

          <div class="mt-6 flex flex-wrap gap-4 text-sm">
            <a href="{{ project.url }}" class="font-medium text-blue-600 hover:text-blue-800 dark:text-blue-400 dark:hover:text-blue-300">View project details</a>
          </div>
        </article>
      {% endfor %}
    </div>
  {% else %}
    <div class="rounded-lg border border-dashed border-gray-300 bg-[var(--surface)] p-6 text-gray-600 dark:border-gray-700 dark:text-gray-300">
      No projects are published yet.
    </div>
  {% endif %}

</div>
