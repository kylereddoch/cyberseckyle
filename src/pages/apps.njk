---
layout: base
permalink: /apps/
title: Apps
description: "Standalone macOS and Windows apps I have built, released, or am actively developing."
appGridColumns: 2
---
{% set gridColumns = 3 if appGridColumns == 3 else 2 %}
{% set appGridClass = 'md:grid-cols-2 lg:grid-cols-3' if gridColumns == 3 else 'md:grid-cols-2' %}

<div class="max-w-4xl">
  <h1 class="text-3xl font-bold mb-2 flex items-center gap-2">
    <span aria-hidden="true">&#128187;</span>
    <span>Apps</span>
  </h1>
  <p class="text-gray-600 dark:text-gray-400 mb-8">
    Standalone software I have released or am actively developing, including independent products published through <a href="https://relaybyte.dev/" class="text-blue-600 hover:text-blue-800 dark:text-blue-400 dark:hover:text-blue-300">RelayByte</a> and open-source desktop utilities. For themes, plugins, scripts, command-line tools, and experiments, visit <a href="/projects/" class="text-blue-600 hover:text-blue-800 dark:text-blue-400 dark:hover:text-blue-300">Projects</a>.
  </p>

  {% if collections.apps and collections.apps.length %}
    <div class="grid grid-cols-1 gap-6 {{ appGridClass }}">
      {% for app in collections.apps %}
        {% set cardSummary = app.data.summary or app.data.description %}
        {% set platformBadgeClasses = app.data.badgeClasses or 'bg-gray-100 text-gray-800 dark:bg-gray-800 dark:text-gray-200' %}
        {% set statusBadgeClasses = 'border border-slate-300 bg-slate-100 text-slate-800 dark:border-slate-600 dark:bg-slate-700 dark:text-slate-100' %}
        <article class="group flex h-full flex-col rounded-lg border border-gray-200 bg-[var(--surface)] p-6 shadow-sm transition-colors hover:border-blue-300 dark:border-gray-800 dark:hover:border-blue-700">
          <div class="flex flex-wrap items-center gap-3">
            <h2 class="text-xl font-semibold leading-tight">{{ app.data.title }}</h2>
            {% if app.data.appPlatform %}
              <span class="rounded-full px-3 py-1 text-xs font-medium {{ platformBadgeClasses }}">{{ app.data.appPlatform }}</span>
            {% endif %}
            {% if app.data.appStatus %}
              <span class="rounded-full px-3 py-1 text-xs font-medium {{ statusBadgeClasses }}">{{ app.data.appStatus }}</span>
            {% endif %}
          </div>

          {% if cardSummary %}
            <p class="mt-3 text-gray-700 dark:text-gray-300">{{ cardSummary }}</p>
          {% endif %}

          {% if app.data.appPrice %}
            <p class="mt-4 text-sm font-medium text-gray-600 dark:text-gray-300">{{ app.data.appPrice }}</p>
          {% endif %}

          <div class="mt-auto pt-6 text-sm">
            <a href="{{ app.url }}" class="font-medium text-blue-600 hover:text-blue-800 dark:text-blue-400 dark:hover:text-blue-300">View app details</a>
          </div>
        </article>
      {% endfor %}
    </div>
  {% else %}
    <div class="rounded-lg border border-dashed border-gray-300 bg-[var(--surface)] p-6 text-gray-600 dark:border-gray-700 dark:text-gray-300">
      No apps are published yet.
    </div>
  {% endif %}
</div>
