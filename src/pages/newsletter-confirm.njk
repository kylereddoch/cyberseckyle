---
layout: base
permalink: /newsletter/confirm/
title: Confirm Your Subscription
description: "Confirm your subscription to The Defender’s Dispatch."
excludeFromSearch: true
---

<article
  class="newsletter-status-page"
  data-newsletter-confirm
  {% if newsletter.configured %}
  data-newsletter-api-url="{{ newsletter.apiUrl }}"
  {% endif %}
>
  <div class="newsletter-status-card">
    <span class="newsletter-status-card__icon" aria-hidden="true" data-newsletter-confirm-icon>&#128737;&#65039;</span>
    <p class="newsletter-kicker" data-newsletter-confirm-kicker>Secure confirmation</p>
    <h1 data-newsletter-confirm-heading>Confirming your subscription…</h1>
    <p>Your browser is securely completing the request. Email scanners cannot activate the subscription by fetching the link alone.</p>

    {% if newsletter.configured %}
    <button class="newsletter-submit" type="button" data-newsletter-confirm-button hidden>
      <span data-newsletter-confirm-label>Try confirmation again</span>
    </button>
    <p class="newsletter-form__status" data-newsletter-confirm-status role="status" aria-live="polite">This should only take a moment.</p>
    {% else %}
    <div class="newsletter-setup-note" role="status">
      <strong>Confirmation is temporarily unavailable.</strong>
      <span>Please try this link again shortly.</span>
    </div>
    {% endif %}

    <p class="newsletter-status-card__muted">If you did not request the newsletter, close this page. The address will remain unsubscribed.</p>
  </div>
</article>

{% if newsletter.configured %}
<script src="/assets/scripts/components/newsletter-signup.min.js" defer></script>
{% endif %}
