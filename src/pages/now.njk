---
layout: base
title: /Now
permalink: /now/
description: "A snapshot of what Kyle Reddoch is focused on right now."
eleventyExcludeFromCollections: true
eleventyImport:
  collections: ["nowEntries"]
---

{% set latestNow = collections.nowEntries | first %}

<article class="mx-auto max-w-3xl">
  <header class="mb-8">
    <h1 class="text-2xl font-bold tracking-tight">/Now</h1>
    <p class="mt-3 text-gray-600 dark:text-gray-400 max-w-2xl">A quick snapshot of what I am focused on lately, inspired by the <a href="https://nownownow.com/about" class="text-purple-600 dark:text-purple-400 hover:underline">/now movement</a>.</p>
  </header>

  {% if latestNow %}
    <section>
      <header class="mb-6">
        <h2 class="text-2xl font-semibold tracking-tight">{{ latestNow.data.title }}</h2>
        <time class="mt-2 block text-sm text-gray-500 dark:text-gray-400" datetime="{{ latestNow.date | htmlDateString }}">Last updated {{ latestNow.date | readableDate }}</time>
      </header>

      <div class="prose max-w-none">
        {{ latestNow.templateContent | safe }}
      </div>
    </section>
  {% else %}
    <p class="text-gray-500 dark:text-gray-400">No /now updates yet.</p>
  {% endif %}
</article>
