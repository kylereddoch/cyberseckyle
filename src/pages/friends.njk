<div class="max-w-4xl">
  <h1 class="text-3xl font-bold mb-2 flex items-center gap-2">
    <span aria-hidden="true">&#128101;</span>
    <span>Friends</span>
  </h1>
  <p class="text-gray-600 dark:text-gray-400 mb-8">
    A growing list of friends, people I have met around the internet, and people whose work I like and admire.
    No rankings, just people worth knowing.
  </p>

  <div class="space-y-8">
    {% for section in sections %}
      <section>
        <h2 class="text-xl font-semibold mb-4">{{ section.title }}</h2>
        <ul class="grid grid-cols-1 md:grid-cols-2 gap-4" role="list">
          {% for person in section.people %}
            <li class="border border-gray-200 dark:border-gray-700 rounded-lg p-4 flex flex-col">
              <h3 class="font-semibold">
                <a
                  class="text-blue-600 dark:text-blue-400 hover:underline"
                  href="{{ person.websiteUrl or person.socialUrl }}"
                  >{{ person.name }}</a
                >
              </h3>
              <p class="text-sm text-gray-600 dark:text-gray-400 mt-1 flex-1">{{ person.note }}</p>
              <div class="flex flex-wrap gap-2 mt-3">
                {% if person.websiteUrl %}
                  <a
                    class="inline-block px-3 py-1 text-xs font-medium rounded-full bg-blue-100 dark:bg-blue-900/30 text-blue-800 dark:text-blue-200 hover:opacity-80 transition-opacity"
                    href="{{ person.websiteUrl }}"
                    aria-label="{{ person.name }} website: {{ person.websiteLabel }}"
                    >{{ person.websiteLabel }}</a
                  >
                {% endif %}
                {% if person.socialUrl %}
                  <a
                    class="inline-block px-3 py-1 text-xs font-medium rounded-full bg-purple-100 dark:bg-purple-900/30 text-purple-800 dark:text-purple-200 hover:opacity-80 transition-opacity"
                    href="{{ person.socialUrl }}"
                    aria-label="{{ person.name }} on {{ person.socialLabel }}"
                    >{{ person.socialLabel }}</a
                  >
                {% endif %}
              </div>
            </li>
          {% endfor %}
        </ul>
      </section>
    {% endfor %}
  </div>

  <p class="mt-8 text-sm text-gray-600 dark:text-gray-400">
    Inspired by
    <a class="text-blue-600 dark:text-blue-400 hover:underline" href="https://slashfriends.org">/friends</a>.
  </p>
</div>
