{% set bodyMetaDescription = "" %}
{% set isPostLike = layout == 'post' or layout == 'note' or layout == 'journal' %}
{% set metaTitle = seoTitle or title or meta.siteName %}
{% set publishedDate = publishedAt or published_at or actualPublishedAt or actual_published_at or page.date %}
{% set modifiedDate = lastModified or lastUpdated or updated or modified or publishedDate %}
{% if isPostLike %}
  {% set bodyMetaDescription = (page.rawInput or content) | metaDescription %}
{% endif %}

{% set metaDescription = description or bodyMetaDescription or meta.siteDescription %}

<meta name="description" content="{{ metaDescription | trim | escape }}" />
<meta name="theme-color" content="{{ meta.themeDark }}" media="(prefers-color-scheme: dark)" />
<!-- Search Engines -->
<meta name="robots" content="index,follow" />
<meta name="googlebot" content="index,follow" />
<!-- Made with Eleventy! -->
<meta name="generator" content="{{ eleventy.generator }}" />
<!-- Disable automatic detection and formatting of possible phone numbers -->
<meta name="format-detection" content="telephone=no" />
<meta name="color-scheme" content="dark light" />
<!-- activates page transitions -->
<meta name="view-transition" content="same-origin" />
<!-- Helps prevent duplicate content issues -->
<link rel="canonical" href="{{ meta.url }}{{ page.url }}" />
<!-- Links to information about the author(s) of the document -->
<link rel="author" href="humans.txt" />

{% if personal.platforms.mastodon %}
  <!-- Mastodon verified site -->
  <link rel="me" href="{{ personal.platforms.mastodon }}" />
{% endif %}

<!-- Delegate IndieAuth sign-in to IndieAuth.com -->
<link rel="authorization_endpoint" href="https://indieauth.com/auth" />

{% if meta.author.fediverse %}
  <!-- fediverse creator tag -->
  <meta name="fediverse:creator" content="{{ meta.author.fediverse }}" />
{% endif %}

{% if meta.url %}
  <link rel="webmention" href="https://webmention.io/{{ meta.url | replace('https://', '') | replace('http://', '') }}/webmention" />
  <link rel="pingback" href="https://webmention.io/{{ meta.url | replace('https://', '') | replace('http://', '') }}/xmlrpc" />
{% endif %}

{% set detailSocialImage = (featuredImage or featured_image) if layout == 'project' or layout == 'app' else '' %}
{% set detailSocialImageAlt = featuredImageAlt or featured_image_alt or alt or title %}

{% if detailSocialImage %}
  {% set socialImage = detailSocialImage | absoluteUrl(meta.url) %}
  {% set socialImageAlt = detailSocialImageAlt %}
{% elif isPostLike %}
  {% set socialImage = meta.url ~ '/assets/og-images/' ~ (slug or title | slugify) ~ '-preview.jpeg' %}
  {% set socialImageAlt = title %}
{% else %}
  {% set socialImage = meta.opengraph_default | absoluteUrl(meta.url) %}
  {% set socialImageAlt = meta.opengraph_default_alt %}
{% endif %}

<!-- Open Graph and X share the same image and accessible description. -->
<meta property="og:url" content="{{ meta.url }}{{ page.url }}" />
<meta property="og:type" content="{% if isPostLike %}article{% else %}website{% endif %}" />
<meta property="og:title" content="{{ metaTitle | escape }}" />
<meta property="og:image" content="{{ socialImage | trim | escape }}" />
<meta property="og:image:alt" content="{{ socialImageAlt | trim | escape }}" />
{% if isPostLike %}
  <meta property="og:image:type" content="image/jpeg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
{% endif %}
<meta property="og:description" content="{{ metaDescription | trim | escape }}" />
<meta property="og:site_name" content="{{ meta.siteName }}" />
<meta property="og:locale" content="{{ meta.locale }}" />
<meta property="article:author" content="{{ meta.author.name }}" />
{% if layout == 'post' or layout == 'note' or layout == 'journal' %}
  <meta property="article:published_time" content="{{ publishedDate | toIsoString }}" />
  <meta property="article:modified_time" content="{{ modifiedDate | toIsoString }}" />
  {% if tags and tags.length %}
    {% for tag in tags %}
      {% if tag != 'posts' and tag != 'notes' and tag != 'journal' %}
        <meta property="article:tag" content="{{ tag }}" />
      {% endif %}
    {% endfor %}
  {% endif %}
{% endif %}

<!-- Explicitly request a wide card so X does not square-crop title artwork. -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@thecyberseckyle" />
<meta name="twitter:creator" content="@thecyberseckyle" />
<meta name="twitter:title" content="{{ metaTitle | escape }}" />
<meta name="twitter:description" content="{{ metaDescription | trim | escape }}" />
<meta name="twitter:image" content="{{ socialImage | trim | escape }}" />
<meta name="twitter:image:alt" content="{{ socialImageAlt | trim | escape }}" />

<!-- RSS Autodiscovery. Loops over meta.blog.feedLinks -->
{% for feedLink in meta.blog.feedLinks %}
  <link
    rel="alternate"
    type="{{ feedLink.type }}"
    title="{{ feedLink.title }}: {{ meta.siteName }}"
    href="{{ feedLink.url }}"
  />
{% endfor %}

{% include "head/structured-data.njk" %}

<!-- Favicon: https://evilmartians.com/chronicles/how-to-favicon-in-2021-six-files-that-fit-most-needs -->
<link rel="icon" href="{{ '/favicon.ico' | url }}" sizes="any" />
<link rel="icon" type="image/svg+xml" href="{{ '/favicon.svg' | url }}" />
<link rel="icon" type="image/png" sizes="96x96" href="{{ '/favicon-96x96.png' | url }}" />
<link rel="apple-touch-icon" sizes="180x180" href="{{ '/apple-touch-icon.png' | url }}" />
<link rel="manifest" href="{{ '/site.webmanifest' | url }}" />
