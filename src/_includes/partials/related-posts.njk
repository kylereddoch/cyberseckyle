{% set relatedPosts = collections.homeEntries | relatedEntries(page.url, tags, 3) %}

{% if relatedPosts.length > 0 %}
  <section class="mt-12 pt-8 border-t border-gray-200 dark:border-gray-700">
    <h2 class="text-xl font-semibold mb-6">Related Posts</h2>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {% for post in relatedPosts %}
        {% set publishedDate = post | publishedDate %}
        <article class="border border-gray-200 dark:border-gray-700 rounded-lg p-4 hover:shadow-md transition-shadow">
          <h3 class="font-semibold mb-2">
            <a href="{{ post.url }}" class="hover:text-blue-600">{{ post.data.title }}</a>
          </h3>
          <time class="text-sm text-gray-500 dark:text-gray-400" datetime="{{ publishedDate | htmlDateString }}">
            {{ publishedDate | readableDate }}
          </time>
          {% if post.data.description %}
            <p class="text-sm text-gray-600 dark:text-gray-400 mt-2">{{ post.data.description }}</p>
          {% endif %}
          {% if post.data.tags %}
            <div class="mt-3 flex flex-wrap gap-1">
              {% for tag in post.data.tags | head(2) %}
                {% if tag != 'posts' and tag != 'journal' %}
                  <span class="text-xs px-2 py-0.5 rounded text-white" style="background-color: {{ tag | tagColor }}">#{{ tag }}</span>
                {% endif %}
              {% endfor %}
            </div>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  </section>
{% endif %}
