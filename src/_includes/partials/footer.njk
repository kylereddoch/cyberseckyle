<footer class="bg-[var(--surface)] border-t border-gray-200 dark:border-gray-700 mt-12">
  <div class="container mx-auto px-4 py-8 max-w-4xl">
    <div class="footer-layout grid grid-cols-1 gap-8 text-sm">
      <section>
        <h2 class="font-semibold mb-3 text-base">Webrings</h2>
        <p class="text-gray-600 dark:text-gray-400 mb-3">This site is part of a few corners of the independent web.</p>
        <ul class="space-y-3 text-gray-600 dark:text-gray-400">
          <li class="space-y-1">
            <p class="font-medium text-gray-900 dark:text-gray-100">
              <a class="hover:text-blue-600" href="https://fediring.net/">Fediring</a>
            </p>
            <div class="flex flex-wrap gap-3">
              <a class="hover:text-blue-600" href="https://fediring.net/previous?host=www.kylereddoch.me">Previous</a>
              <a class="hover:text-blue-600" href="https://fediring.net/random?host=www.kylereddoch.me">Random</a>
              <a class="hover:text-blue-600" href="https://fediring.net/next?host=www.kylereddoch.me">Next</a>
            </div>
          </li>
          <li class="space-y-1">
            <p class="font-medium text-gray-900 dark:text-gray-100">
              <a class="hover:text-blue-600" href="https://xn--sr8hvo.ws/">IndieWeb Webring</a>
            </p>
            <div class="flex flex-wrap gap-3">
              <a class="hover:text-blue-600" href="https://xn--sr8hvo.ws/previous">Previous</a>
              <a class="hover:text-blue-600" href="https://xn--sr8hvo.ws/random">Random</a>
              <a class="hover:text-blue-600" href="https://xn--sr8hvo.ws/next">Next</a>
            </div>
          </li>
          <li>
            <a href="https://tinylytics.app" class="tinylytics_webring hover:text-blue-600">Tinylytics Webring</a>
          </li>
        </ul>
        <p class="mt-4 text-gray-600 dark:text-gray-400">Proud member of <a class="hover:text-blue-600" href="https://darktheme.club">darktheme.club</a></p>
      </section>

      <section>
        <h2 class="font-semibold mb-3 text-base">Explore</h2>
        <ul class="space-y-2 text-gray-600 dark:text-gray-400">
          <li><a class="hover:text-blue-600" href="/topics/">Topics</a></li>
          <li><a class="hover:text-blue-600" href="/projects/">Projects</a></li>
          <li><a class="hover:text-blue-600" href="/slashes/">Slashes</a></li>
          <li><a class="hover:text-blue-600" href="/blog/">Blog</a></li>
          <li><a class="hover:text-blue-600" href="/newsletter/">The Defender’s Dispatch</a></li>
          <li><a class="hover:text-blue-600" href="/notes/">Notes</a></li>
          <li><a class="hover:text-blue-600" href="/donate/">Support</a></li>
          <li><a class="hover:text-blue-600" href="/tags/">Tags</a></li>
          <li><a class="hover:text-blue-600" href="/sitemap/">Site Directory</a></li>
        </ul>
      </section>

      <section>
        <h2 class="font-semibold mb-3 text-base">Connect</h2>

        <nav class="platforms flex flex-wrap gap-3 mb-4" aria-label="{{ meta.navigation.ariaPlatforms }}">
          <a class="hover:text-blue-600" href="{{ meta.blog.feedLinks[0].url }}" rel="alternate" type="{{ meta.blog.feedLinks[0].type }}">
            <span class="visually-hidden">{{ meta.blog.feedLinks[0].title }}</span>
            {% svg "misc/rss" %}
          </a>
          {% for key, value in personal.platforms %}
            {% if value != "" %}
              <a class="hover:text-blue-600" href="{{ value }}" rel="me" title="{{ key | capitalize }}">
                <span class="visually-hidden">{{ key | capitalize }}</span>
                {% svg 'platform/' + key %}
              </a>
            {% endif %}
          {% endfor %}
        </nav>

        <p class="text-gray-600 dark:text-gray-400 mb-2">
          Made with <span aria-hidden="true">&hearts;</span> and <a class="hover:text-blue-600" href="https://www.11ty.dev/">Eleventy</a>
        </p>
        <p class="text-gray-600 dark:text-gray-400 mb-2">
          Analytics powered by <a class="hover:text-blue-600" href="https://tinylytics.app">Tinylytics</a>
        </p>
        <p class="text-gray-600 dark:text-gray-400 mb-4">
          I care about your <a class="hover:text-blue-600" href="/privacy/">Privacy</a>
        </p>

        <p class="mb-4 text-sm text-gray-600 dark:text-gray-300">
        &copy; {% year %} <span class="font-semibold">{{ meta.siteName }}</span>
        <span class="mx-2" aria-hidden="true">&middot;</span>
        <a class="hover:text-blue-600" href="/license/">CC BY-NC-SA 4.0</a>
      </p>
      </section>
    </div>
  </div>

