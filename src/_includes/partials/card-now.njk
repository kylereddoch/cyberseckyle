{% set headingLevel = headingLevel | default("h3") %}
{% set definedDate = definedDate | default(item.date) %}
{% set showTags = showTags | default(true) %}

<custom-card clickable>
  {# Headline / title #}
  <{{ headingLevel }} slot="headline" class="text-step-2">
    <a href="{{ item.url | url }}">{{ item.data.title }}</a>
  </{{ headingLevel }}>

  {# Date (same pattern as card-blog) #}
  <span slot="date">
    {%- if item.data.draft -%}
      <span class="button" data-small-button data-button-variant='tertiary'>draft</span>
    {%- endif %}
    {% include "partials/date.njk" %}
  </span>

  {# Tags: show non-now, non-posts tags #}
  {% if showTags and item.data.tags and item.data.tags.length > 1 %}
    <div slot="tag" webc:nokeep>
      {% for tag in item.data.tags %}
        {% if tag != "posts" %}
          <span class="button" data-small-button>#{{ tag }}</span>
        {% endif %}
      {% endfor %}
    </div>
  {% endif %}

  {# Card content – description (same as blog cards) #}
  <div slot="content" webc:nokeep>
    {{ (item.data.description or "") | markdownFormat | safe }}
  </div>
</custom-card>

{% css "local" %}
  {% include "css/custom-card.css" %}
{% endcss %}
