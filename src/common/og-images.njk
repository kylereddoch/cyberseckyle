---
fontDisplay: "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif"
fontBody: "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif"
backgroundBase: "#0f0a1a"
backgroundOverlay: "rgb(88 28 135 / 0.2)"
text: "rgb(216 180 254)"
siteUrl: "kylereddoch.me"
pagination:
  data: collections.allPosts
  size: 1
  alias: post
permalink: "/assets/og-images/{{ post.data.slug or post.data.title | slugify }}-preview.svg"
eleventyExcludeFromCollections: true

---

{# -------------------------------
   Auto-fit title sizing (heuristic)
   - Dynamic wrapping so the title uses the full width
   - Font size scales to fit, not the "area"
   ------------------------------- #}

{% set svgWidth = 1200 %}
{% set paddingX = 160 %}
{% set maxTextWidth = svgWidth - (paddingX * 2) %}

{# Title layout box (controls vertical space only) #}
{% set titleBoxTop = 185 %}
{% set titleBoxBottom = 535 %}
{% set titleBoxHeight = titleBoxBottom - titleBoxTop %}

{# Typography tuning knobs #}
{% set maxFontSize = 80 %}
{% set minFontSize = 44 %}
{% set lineHeightFactor = 1.07 %}
{% set ascentFactor = 0.78 %}
{% set approxCharWidth = 0.60 %}

{# -------------------------------
   Pass 1: wrap using maxFontSize estimate
   ------------------------------- #}

{%
  set charsPerLine = (maxTextWidth / (maxFontSize * approxCharWidth)) | round(0, 'floor')
%}
{% if charsPerLine < 18 %}{% set charsPerLine = 18 %}{% endif %}
{% if charsPerLine > 60 %}{% set charsPerLine = 60 %}{% endif %}

{% set titleInLines = post.data.title | splitlines(charsPerLine) %}
{% set numberOfLines = titleInLines.length %}

{% set maxLineLen = 0 %}
{% for line in titleInLines %}
  {% set lineLen = line | length %}
  {% if lineLen > maxLineLen %}
    {% set maxLineLen = lineLen %}
  {% endif %}
{% endfor %}

{% set safeMaxLineLen = maxLineLen or 1 %}
{% set safeNumberOfLines = numberOfLines or 1 %}

{% set sizeByWidth = maxTextWidth / (safeMaxLineLen * approxCharWidth) %}
{% set heightDenom = 1 + ((safeNumberOfLines - 1) * lineHeightFactor) %}
{% set sizeByHeight = titleBoxHeight / heightDenom %}

{% set titleFontSize = maxFontSize %}
{% if sizeByWidth < titleFontSize %}{% set titleFontSize = sizeByWidth %}{%
  endif
%}
{% if sizeByHeight < titleFontSize %}{% set titleFontSize = sizeByHeight %}{%
  endif
%}
{% if titleFontSize < minFontSize %}{% set titleFontSize = minFontSize %}{%
  endif
%}
{% if titleFontSize > maxFontSize %}{% set titleFontSize = maxFontSize %}{%
  endif
%}

{# -------------------------------
   Pass 2: wrap again using the computed font size
   This is the key change that stops “half-width” lines.
   ------------------------------- #}

{%
  set charsPerLine2 = (maxTextWidth / (titleFontSize * approxCharWidth)) | round(0, 'floor')
%}
{# add a little slack so lines run longer before wrapping #}
{% set charsPerLine2 = charsPerLine2 + 2 %}
{% if charsPerLine2 < 18 %}{% set charsPerLine2 = 18 %}{% endif %}
{% if charsPerLine2 > 60 %}{% set charsPerLine2 = 60 %}{% endif %}

{% set titleInLines = post.data.title | splitlines(charsPerLine2) %}
{% set numberOfLines = titleInLines.length %}

{% set maxLineLen = 0 %}
{% for line in titleInLines %}
  {% set lineLen = line | length %}
  {% if lineLen > maxLineLen %}
    {% set maxLineLen = lineLen %}
  {% endif %}
{% endfor %}

{% set safeMaxLineLen = maxLineLen or 1 %}
{% set safeNumberOfLines = numberOfLines or 1 %}

{% set sizeByWidth = maxTextWidth / (safeMaxLineLen * approxCharWidth) %}
{% set heightDenom = 1 + ((safeNumberOfLines - 1) * lineHeightFactor) %}
{% set sizeByHeight = titleBoxHeight / heightDenom %}

{% set titleFontSize = maxFontSize %}
{% if sizeByWidth < titleFontSize %}{% set titleFontSize = sizeByWidth %}{%
  endif
%}
{% if sizeByHeight < titleFontSize %}{% set titleFontSize = sizeByHeight %}{%
  endif
%}
{% if titleFontSize < minFontSize %}{% set titleFontSize = minFontSize %}{%
  endif
%}
{% if titleFontSize > maxFontSize %}{% set titleFontSize = maxFontSize %}{%
  endif
%}

{% set titleLineHeight = titleFontSize * lineHeightFactor %}
{%
  set titleBlockHeight = ((safeNumberOfLines - 1) * titleLineHeight) + titleFontSize
%}

{%
  set titleStartY = titleBoxTop + ((titleBoxHeight - titleBlockHeight) / 2) + (titleFontSize * ascentFactor)
%}
{% set dateY = titleStartY - (titleFontSize * ascentFactor) - 40 %}

{% set titleLetterSpacing = (-3 * (titleFontSize / maxFontSize)) %}

<svg
  width="1200"
  height="630"
  viewBox="0 0 1200 630"
  version="1.1"
  xmlns="http://www.w3.org/2000/svg"
  xmlns:xlink="http://www.w3.org/1999/xlink"
>
  <rect id="bg-base" width="100%" height="100%" opacity="1" fill="{{ backgroundBase }}" />
  <rect id="bg-overlay" width="100%" height="100%" opacity="1" fill="{{ backgroundOverlay }}" />

  <!-- date -->
  <text
    font-family="{{ fontBody }}, sans-serif"
    font-size="22"
    font-weight="500"
    fill="{{ text }}"
    letter-spacing="-1"
  >
    <tspan x="160" y="{{ dateY }}">
      {{ post.date | formatDate('MM / DD / YYYY') }}
    </tspan>
  </text>

  <!-- title -->
  <text
    id="text"
    font-family="{{ fontDisplay }}, sans-serif"
    font-size="{{ titleFontSize }}"
    font-weight="700"
    fill="{{ text }}"
    letter-spacing="{{ titleLetterSpacing | round(2) }}"
  >
    {% for line in titleInLines %}
      <tspan x="160" y="{{ titleStartY + (loop.index0 * titleLineHeight) }}">
        {{ line }}
      </tspan>
    {% endfor %}
  </text>

  <!-- url -->
  <text
    font-family="{{ fontBody }}, sans-serif"
    font-size="22"
    font-weight="500"
    fill="{{ text }}"
    letter-spacing="-0.5"
  >
    <tspan x="160" y="580">{{ siteUrl }}</tspan>
  </text>

  <!-- sitename -->
  <text
    font-family="{{ fontDisplay }}, sans-serif"
    font-size="20"
    font-weight="600"
    fill="{{ text }}"
    letter-spacing="-0.5"
  >
    <tspan x="950" y="580">{{ meta.siteName | upper }}</tspan>
  </text>
</svg>
