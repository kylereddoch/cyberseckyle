---
layout: base
---

<a href="/notes/" class="inline-flex items-center text-blue-600 hover:text-blue-800 mb-3">
  &larr; Back to Notes
</a>

<nav class="text-sm text-gray-600 dark:text-gray-400 mb-4" aria-label="Breadcrumb">
  <ol class="flex flex-wrap items-center gap-2">
    <li><a href="/" class="hover:text-blue-600">Home</a></li>
    <li aria-hidden="true">/</li>
    <li><a href="/notes/" class="hover:text-blue-600">Notes</a></li>
    <li aria-hidden="true">/</li>
    <li class="text-gray-900 dark:text-gray-100">{{ title }}</li>
  </ol>
</nav>

<article class="h-entry mx-auto max-w-3xl">
  {% set heroImage = featuredImage or featured_image %}
  {% set heroImageAlt = featuredImageAlt or featured_image_alt or alt or ('Featured image for ' ~ title) %}
  {% set webmentionBase = meta.author.website or meta.url %}
  {% set pageWebmentionTarget = page.url | url | absoluteUrl(webmentionBase) | webmentionTarget %}
  {% set pageMentions = webmentions.byTarget | lookup(pageWebmentionTarget) %}
  {% set mastodonDiscussionUrl = mastodon_url or pageMentions.syndicationUrl %}
  {% set mastodonAccountUrl = meta.creator.social or meta.author.website %}
  {% set publishedDate = publishedAt or published_at or actualPublishedAt or actual_published_at or page.date %}

    {% if heroImage %}
    <div class="mb-8">
      <img class="u-photo w-full rounded-lg" src="{{ heroImage }}" alt="{{ heroImageAlt }}" />
      {% if featuredImageCaption %}
        <p class="text-sm text-gray-600 dark:text-gray-400 mt-4 text-center">{{ featuredImageCaption | featuredImageCaptionHtml | safe }}</p>
      {% endif %}
    </div>
  {% endif %}

  <header class="mb-6">
    <h1 class="p-name text-3xl font-bold tracking-tight mb-2">{{ title }}</h1>
    {% if description %}
      <p class="text-lg text-gray-600 dark:text-gray-400 mb-3">{{ description }}</p>
    {% endif %}
    <div class="text-sm text-gray-600 dark:text-gray-400">
      Published on <time class="dt-published" datetime="{{ publishedDate | toIsoString }}">{{ publishedDate | readableDateTime }}</time>
      by <span class="p-author h-card">
        <a class="u-url p-name hover:text-blue-600" href="/about/">{{ meta.author.name }}</a>
      </span>
      <span aria-hidden="true" class="text-gray-400 dark:text-gray-500 mx-1">&bull;</span>
      <span>{{ content | readTime }}</span>
    </div>
  </header>

  <div class="e-content prose max-w-none">
    {{ content | safe }}
  </div>

  {% if tags and tags.length %}
    <section class="mt-8 pt-6 border-t border-gray-200 dark:border-gray-700">
      <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-3">Tags</h2>
      <div class="flex flex-wrap gap-2">
        {% for tag in tags %}
          {% if tag != 'posts' and tag != 'journal' %}
            <a class="p-category px-3 py-1 text-sm rounded-full hover:opacity-85 transition-opacity" style="background-color: {{ tag | tagColor }}; color: {{ tag | tagTextColor }}" href="/tags/{{ tag | slug }}/">#{{ tag }}</a>
          {% endif %}
        {% endfor %}
      </div>
    </section>
  {% endif %}

  <section class="mt-8 pt-6 border-t border-gray-200 dark:border-gray-700">
    <h2 class="text-xl font-semibold mb-2">Share or join the conversation</h2>
    <p class="text-gray-600 dark:text-gray-400 mb-4">Share this note, open the Mastodon thread, or leave a little kudos.</p>
    {% include "partials/share-links.njk" %}

    <template id="mastodon-post-template">
      {% include "partials/mastodon-temp.njk" %}
    </template>

    <div class="discuss-mastodon mt-6{% if not mastodonDiscussionUrl %} hidden{% endif %}"
         data-mastodon-discussion
         data-mastodon-account="{{ mastodonAccountUrl }}"
         data-mastodon-current="{{ mastodonDiscussionUrl }}">
      {% if mastodonDiscussionUrl %}
        <div class="discuss-mastodon__intro">
          <div class="discuss-mastodon__mark" aria-hidden="true">
            <i class="fa-brands fa-mastodon" aria-hidden="true"></i>
          </div>
          <div class="discuss-mastodon__copy">
            <h3>Discuss on Mastodon</h3>
          </div>
          <a href="{{ mastodonDiscussionUrl }}" rel="syndication noopener" target="_blank" class="discuss-mastodon__button u-syndication no-indicator">Open thread</a>
        </div>
        <mastodon-post url="{{ mastodonDiscussionUrl }}"></mastodon-post>
      {% endif %}
    </div>

    <div class="mt-6">
      <p class="text-sm text-gray-600 dark:text-gray-400 mb-2">Give this note some kudos.</p>
      <button class="tinylytics_kudos" data-path="{{ page.url | url }}"></button>
    </div>
  </section>

  {% include "partials/webmentions.njk" %}

  <a class="u-bridgy-fed" href="https://fed.brid.gy/" hidden="from-humans">Bridge this note to Bridgy Fed</a>
  {% if mastodonDiscussionUrl %}
    <a hidden class="u-syndication" rel="syndication" href="{{ mastodonDiscussionUrl }}">Syndicated on Mastodon</a>
  {% endif %}
  {% if x_url %}
    <a hidden class="u-syndication" rel="syndication" href="{{ x_url }}">Syndicated on X</a>
  {% endif %}
</article>
