---
layout: base
---

<article class="mx-auto max-w-3xl">
  <header class="mb-8">
    <h1 class="text-3xl font-bold tracking-tight">{{ title }}</h1>
    {% if description %}
      <p class="mt-3 text-gray-600 dark:text-gray-400 max-w-2xl">{{ description }}</p>
    {% endif %}
  </header>

  <div class="prose max-w-none">
    {{ content | safe }}
  </div>
</article>
